{
  "name": "@natsail/session",
  "version": "0.1.0",
  "description": "Keyed lifecycle and shared state for NATSail subscription sources.",
  "keywords": [
    "nats",
    "session",
    "state",
    "subscription",
    "streaming"
  ],
  "license": "Apache-2.0",
