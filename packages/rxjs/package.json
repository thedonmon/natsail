{
  "name": "@natsail/rxjs",
  "version": "0.1.0",
  "description": "RxJS Observables for NATSail runtimes and shared sessions.",
  "keywords": [
    "nats",
    "rxjs",
    "observable",
    "subscription",
    "streaming"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thedonmon/natsail.git",
    "directory": "packages/rxjs"
  },
  "homepage": "https://github.com/thedonmon/natsail/tree/main/packages/rxjs#readme",
  "bugs": {
    "url": "https://github.com/thedonmon/natsail/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@natsail/core": "workspace:^",
    "@natsail/session": "workspace:^"
  },
  "peerDependencies": {
    "rxjs": "^7.8.0"
  }
}
