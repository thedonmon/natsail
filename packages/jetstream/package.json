{
  "name": "@natsail/jetstream",
  "version": "0.5.0",
  "description": "Ordered JetStream replay and application checkpoints for NATSail runtimes.",
  "keywords": [
    "nats",
    "jetstream",
    "checkpoint",
    "replay",
    "streaming"
  ],
  "license": "Apache-2.0",
