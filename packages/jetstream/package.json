      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thedonmon/natsail.git",
    "directory": "packages/jetstream"
  },
  "homepage": "https://github.com/thedonmon/natsail/tree/main/packages/jetstream#readme",
  "bugs": {
    "url": "https://github.com/thedonmon/natsail/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@natsail/checkpoints": "workspace:^",
    "@natsail/core": "workspace:^",
    "@natsail/session": "workspace:^",
    "@nats-io/jetstream": "^3.4.0"
