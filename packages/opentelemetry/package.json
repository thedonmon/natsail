{
  "name": "@natsail/opentelemetry",
  "version": "0.1.0",
  "description": "Optional OpenTelemetry metrics sink for NATSail runtimes and sessions.",
  "keywords": [
    "nats",
    "opentelemetry",
    "metrics",
    "observability",
    "telemetry"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thedonmon/natsail.git",
    "directory": "packages/opentelemetry"
  },
  "homepage": "https://github.com/thedonmon/natsail/tree/main/packages/opentelemetry#readme",
  "bugs": {
    "url": "https://github.com/thedonmon/natsail/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@natsail/core": "workspace:^"
  },
  "peerDependencies": {
    "@opentelemetry/api": ">=1.9.0 <2"
  }
}
