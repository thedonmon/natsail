{
  "name": "@natsail/effect",
  "version": "0.1.0",
  "description": "Scoped Effect v4 Streams for Core NATS subjects, operations, and shared sessions.",
  "keywords": [
    "nats",
    "effect",
    "stream",
    "resource-management",
    "subscription"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
