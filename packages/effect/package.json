  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thedonmon/natsail.git",
    "directory": "packages/effect"
  },
  "homepage": "https://github.com/thedonmon/natsail/tree/main/packages/effect#readme",
  "bugs": {
    "url": "https://github.com/thedonmon/natsail/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@natsail/core": "workspace:^",
    "@natsail/session": "workspace:^"
  },
  "peerDependencies": {
    "effect": "4.0.0-rc.112"
  }
