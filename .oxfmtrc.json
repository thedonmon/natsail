{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "semi": false,
  "singleQuote": true,
  "trailingComma": "es5",
  "sortImports": false,
  "ignorePatterns": [
    "/*",
    "!/packages/",
    "/packages/*/*",
    "!/packages/*/src/",
    "!/packages/*/CHANGELOG.md",
    "**/node_modules/**",
    "**/dist/**",
    "**/__tests__/**",
    "**/*.test.*",
    "**/*.spec.*"
  ]
}
